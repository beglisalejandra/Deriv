<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <!--
    Matches con martingala x2.2 — replica del bot del video.
    Volatility 75 (1s) Index, Digits -> Matches/Differs -> Matches.

    ADVERTENCIA MEDIDA, NO OPINION:
    docs/backtest.js simula este plan 5.000 veces (stake base 1 USD, banca 100 USD,
    200 operaciones por sesion). Resultado: 88% de las sesiones terminan sin capital
    con tope de 5 pasos, y 100% sin tope. La escalera completa de 8 pasos exige
    456 USD para recuperar 1 USD.

    Se incluye porque es lo que aparece en el video. La version de stake fijo
    (matches-stake-fijo.xml) pierde mucho mas despacio.
  -->
  <variables>
    <variable id="v_stake">stake</variable>
    <variable id="v_base">stake_base</variable>
    <variable id="v_mart">martingala</variable>
    <variable id="v_pred">prediccion</variable>
    <variable id="v_pasos">pasos_perdidos</variable>
    <variable id="v_maxpasos">pasos_maximos</variable>
  </variables>

  <block type="trade_definition" id="td" deletable="false" movable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="tdm" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ75V</field>
        <next>
          <block type="trade_definition_tradetype" id="tdt" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="tdc" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="tdci" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="tdrb" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="tdre" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="i1">
        <field name="VAR" id="v_base">stake_base</field>
        <value name="VALUE"><block type="math_number" id="n1"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="i2">
            <field name="VAR" id="v_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="g1"><field name="VAR" id="v_base">stake_base</field></block></value>
            <next>
              <block type="variables_set" id="i3">
                <field name="VAR" id="v_mart">martingala</field>
                <value name="VALUE"><block type="math_number" id="n2"><field name="NUM">2.2</field></block></value>
                <next>
                  <block type="variables_set" id="i4">
                    <field name="VAR" id="v_pred">prediccion</field>
                    <value name="VALUE"><block type="math_number" id="n3"><field name="NUM">5</field></block></value>
                    <next>
                      <block type="variables_set" id="i5">
                        <field name="VAR" id="v_pasos">pasos_perdidos</field>
                        <value name="VALUE"><block type="math_number" id="n4"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="variables_set" id="i6">
                            <field name="VAR" id="v_maxpasos">pasos_maximos</field>
                            <value name="VALUE"><block type="math_number" id="n5"><field name="NUM">5</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tdo">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION"><block type="math_number" id="n6"><field name="NUM">1</field></block></value>
        <value name="AMOUNT"><block type="variables_get" id="g2"><field name="VAR" id="v_stake">stake</field></block></value>
        <value name="PREDICTION"><block type="variables_get" id="g3"><field name="VAR" id="v_pred">prediccion</field></block></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="bp" deletable="false" movable="false" x="0" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="pur">
        <field name="PURCHASE_LIST">DIGITMATCH</field>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="ap" deletable="false" movable="false" x="0" y="660">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="if1">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="ccr"><field name="CHECK_RESULT">win</field></block>
        </value>
        <!-- Gano: vuelve al stake base y reinicia la escalera. -->
        <statement name="DO0">
          <block type="variables_set" id="w1">
            <field name="VAR" id="v_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="g4"><field name="VAR" id="v_base">stake_base</field></block></value>
            <next>
              <block type="variables_set" id="w2">
                <field name="VAR" id="v_pasos">pasos_perdidos</field>
                <value name="VALUE"><block type="math_number" id="n7"><field name="NUM">0</field></block></value>
              </block>
            </next>
          </block>
        </statement>
        <!-- Perdio: sube un escalon, salvo que ya se alcanzo el tope. -->
        <statement name="ELSE">
          <block type="variables_set" id="l1">
            <field name="VAR" id="v_pasos">pasos_perdidos</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="a1">
                <field name="OP">ADD</field>
                <value name="A"><block type="variables_get" id="g5"><field name="VAR" id="v_pasos">pasos_perdidos</field></block></value>
                <value name="B"><block type="math_number" id="n8"><field name="NUM">1</field></block></value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="if2">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="c1">
                    <field name="OP">GTE</field>
                    <value name="A"><block type="variables_get" id="g6"><field name="VAR" id="v_pasos">pasos_perdidos</field></block></value>
                    <value name="B"><block type="variables_get" id="g7"><field name="VAR" id="v_maxpasos">pasos_maximos</field></block></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set" id="r1">
                    <field name="VAR" id="v_stake">stake</field>
                    <value name="VALUE"><block type="variables_get" id="g8"><field name="VAR" id="v_base">stake_base</field></block></value>
                    <next>
                      <block type="variables_set" id="r2">
                        <field name="VAR" id="v_pasos">pasos_perdidos</field>
                        <value name="VALUE"><block type="math_number" id="n9"><field name="NUM">0</field></block></value>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="variables_set" id="m1">
                    <field name="VAR" id="v_stake">stake</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="a2">
                        <field name="OP">MULTIPLY</field>
                        <value name="A"><block type="variables_get" id="g9"><field name="VAR" id="v_stake">stake</field></block></value>
                        <value name="B"><block type="variables_get" id="g10"><field name="VAR" id="v_mart">martingala</field></block></value>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="ta"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
