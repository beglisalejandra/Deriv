<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <!--
    MATCHES x9 — pago alto con gestion de riesgo
    Volatility 75 (1s) Index

    EL PAGO ES x8.9 A x9.5 SEGUN EL INDICE Y EL MOMENTO. Ese multiplicador
    es lo que buscabas: cada acierto devuelve unas nueve veces el stake.

    EL PARAMETRO DE ENTRADA QUE SI ES REAL
    No se puede mover la probabilidad de acertar: es 10% para cualquier
    digito, en cualquier momento, mire uno lo que mire. Lo que SI varia, y
    mucho, es el PAGO que cotiza Deriv segun el indice:

        pago     valor esperado por operacion
        x8.50          -15.0%
        x8.93          -10.7%
        x9.30           -7.0%
        x9.50           -5.0%

    De x8.50 a x9.50 la sangria se divide entre tres. Por eso la aplicacion
    que acompana a este bot escanea los indices en vivo y dice en cual esta
    el pago mas alto ahora mismo. Ese es el filtro de entrada real: no se
    entra en cualquier sitio, se entra donde mejor pagan.

    Abre la aplicacion, mira que indice senala, ponlo en el desplegable
    "Market" de este bot, y dale a Run cuando el semaforo este en verde.

    PARAMETROS DE SESION, buscados sobre 6.000 sesiones por combinacion
    exigiendo que la sesion dure al menos 20 operaciones:
      stake                  1
      objetivo_sesion        8
      limite_sesion         15
      retroceso_maximo      12
      max_perdidas_seguidas 25

    RESULTADO MEDIDO con pago x9.30
      21 operaciones por sesion
      53.7% de las sesiones cierran en verde
      -1.33 USD de media por sesion

    LO QUE HAY QUE ENTENDER DEL 53.7%
    Mas de la mitad de las sesiones acaban en positivo. Eso es cierto y es
    lo que se ve. La media sigue siendo negativa porque las sesiones que
    pierden, pierden mas de lo que ganan las que ganan. Con Matches se
    acierta 1 de cada 10: la mayoria de las operaciones son fallos y lo que
    sostiene la sesion es que un acierto paga nueve.

    Importar en bot.deriv.com -> icono de carpeta -> Local.
    Probar SIEMPRE primero en cuenta Demo.
  -->
  <variables>
    <variable id="vstake">stake</variable>
    <variable id="vses">ganancia_sesion</variable>
    <variable id="vpico">pico_ganancia</variable>
    <variable id="vretro">retroceso_maximo</variable>
    <variable id="vobj">objetivo_sesion</variable>
    <variable id="vlim">limite_sesion</variable>
    <variable id="vracha">perdidas_seguidas</variable>
    <variable id="vmax">max_perdidas_seguidas</variable>
  </variables>

  <block type="trade_definition" id="td" deletable="false" movable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="tdm" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ75V</field>
        <next><block type="trade_definition_tradetype" id="tdt" deletable="false" movable="false">
          <field name="TRADETYPECAT_LIST">digits</field>
          <field name="TRADETYPE_LIST">matchesdiffers</field>
          <next><block type="trade_definition_contracttype" id="tdc" deletable="false" movable="false">
            <field name="TYPE_LIST">DIGITMATCH</field>
            <next><block type="trade_definition_candleinterval" id="tdci" deletable="false" movable="false">
              <field name="CANDLEINTERVAL_LIST">60</field>
              <next><block type="trade_definition_restartbuysell" id="tdrb" deletable="false" movable="false">
                <field name="TIME_MACHINE_ENABLED">FALSE</field>
                <next><block type="trade_definition_restartonerror" id="tdre" deletable="false" movable="false">
                  <field name="RESTARTONERROR">TRUE</field>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>

    <statement name="INITIALIZATION">
<block type="variables_set" id="s_vstake"><field name="VAR" id="vstake">stake</field><value name="VALUE"><block type="math_number" id="v_vstake"><field name="NUM">1</field></block></value>
<next>
<block type="variables_set" id="s_vses"><field name="VAR" id="vses">ganancia_sesion</field><value name="VALUE"><block type="math_number" id="v_vses"><field name="NUM">0</field></block></value>
<next>
<block type="variables_set" id="s_vpico"><field name="VAR" id="vpico">pico_ganancia</field><value name="VALUE"><block type="math_number" id="v_vpico"><field name="NUM">0</field></block></value>
<next>
<block type="variables_set" id="s_vretro"><field name="VAR" id="vretro">retroceso_maximo</field><value name="VALUE"><block type="math_number" id="v_vretro"><field name="NUM">12</field></block></value>
<next>
<block type="variables_set" id="s_vobj"><field name="VAR" id="vobj">objetivo_sesion</field><value name="VALUE"><block type="math_number" id="v_vobj"><field name="NUM">8</field></block></value>
<next>
<block type="variables_set" id="s_vlim"><field name="VAR" id="vlim">limite_sesion</field><value name="VALUE"><block type="math_number" id="v_vlim"><field name="NUM">15</field></block></value>
<next>
<block type="variables_set" id="s_vracha"><field name="VAR" id="vracha">perdidas_seguidas</field><value name="VALUE"><block type="math_number" id="v_vracha"><field name="NUM">0</field></block></value>
<next>
<block type="variables_set" id="s_vmax"><field name="VAR" id="vmax">max_perdidas_seguidas</field><value name="VALUE"><block type="math_number" id="v_vmax"><field name="NUM">25</field></block></value></block>
</next></block>
</next></block>
</next></block>
</next></block>
</next></block>
</next></block>
</next></block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tdo">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION"><block type="math_number" id="ndur"><field name="NUM">1</field></block></value>
        <value name="AMOUNT"><block type="variables_get" id="gstake"><field name="VAR" id="vstake">stake</field></block></value>
        <value name="PREDICTION"><block type="math_number" id="npred"><field name="NUM">1</field></block></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="bp" deletable="false" movable="false" x="0" y="700">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="pur"><field name="PURCHASE_LIST">DIGITMATCH</field></block>
    </statement>
  </block>

  <block type="after_purchase" id="ap" deletable="false" movable="false" x="0" y="840">
    <statement name="AFTERPURCHASE_STACK">

      <block type="variables_set" id="acc">
        <field name="VAR" id="vses">ganancia_sesion</field>
        <value name="VALUE"><block type="math_arithmetic" id="sum"><field name="OP">ADD</field>
          <value name="A"><block type="variables_get" id="g1"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
          <value name="B"><block type="read_details" id="rd"><field name="DETAIL_INDEX">4</field></block></value>
        </block></value>
        <next>

        <block type="controls_if" id="ifpico">
          <mutation elseif="0" else="0"></mutation>
          <value name="IF0"><block type="logic_compare" id="cpico"><field name="OP">GT</field>
            <value name="A"><block type="variables_get" id="g2"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
            <value name="B"><block type="variables_get" id="g3"><field name="VAR" id="vpico">pico_ganancia</field></block></value>
          </block></value>
          <statement name="DO0"><block type="variables_set" id="setpico">
            <field name="VAR" id="vpico">pico_ganancia</field>
            <value name="VALUE"><block type="variables_get" id="g4"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
          </block></statement>
          <next>

          <block type="controls_if" id="ifres">
            <mutation else="1"></mutation>
            <value name="IF0"><block type="contract_check_result" id="ccr"><field name="CHECK_RESULT">win</field></block></value>
            <statement name="DO0"><block type="variables_set" id="reset">
              <field name="VAR" id="vracha">perdidas_seguidas</field>
              <value name="VALUE"><block type="math_number" id="ncero"><field name="NUM">0</field></block></value>
            </block></statement>
            <statement name="ELSE"><block type="variables_set" id="inc">
              <field name="VAR" id="vracha">perdidas_seguidas</field>
              <value name="VALUE"><block type="math_arithmetic" id="add1"><field name="OP">ADD</field>
                <value name="A"><block type="variables_get" id="g5"><field name="VAR" id="vracha">perdidas_seguidas</field></block></value>
                <value name="B"><block type="math_number" id="nuno"><field name="NUM">1</field></block></value>
              </block></value>
            </block></statement>
            <next>

            <block type="controls_if" id="ifgo">
              <mutation elseif="0" else="0"></mutation>
              <value name="IF0">
                <block type="logic_operation" id="and1"><field name="OP">AND</field>
                  <value name="A"><block type="logic_compare" id="cObj"><field name="OP">LT</field>
                    <value name="A"><block type="variables_get" id="g6"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
                    <value name="B"><block type="variables_get" id="g7"><field name="VAR" id="vobj">objetivo_sesion</field></block></value>
                  </block></value>
                  <value name="B">
                    <block type="logic_operation" id="and2"><field name="OP">AND</field>
                      <value name="A"><block type="logic_compare" id="cLim"><field name="OP">GT</field>
                        <value name="A"><block type="variables_get" id="g8"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
                        <value name="B"><block type="math_single" id="neg"><field name="OP">NEG</field>
                          <value name="NUM"><block type="variables_get" id="g9"><field name="VAR" id="vlim">limite_sesion</field></block></value>
                        </block></value>
                      </block></value>
                      <value name="B">
                        <block type="logic_operation" id="and3"><field name="OP">AND</field>
                          <value name="A"><block type="logic_compare" id="cRetro"><field name="OP">LT</field>
                            <value name="A"><block type="math_arithmetic" id="resta"><field name="OP">MINUS</field>
                              <value name="A"><block type="variables_get" id="g10"><field name="VAR" id="vpico">pico_ganancia</field></block></value>
                              <value name="B"><block type="variables_get" id="g11"><field name="VAR" id="vses">ganancia_sesion</field></block></value>
                            </block></value>
                            <value name="B"><block type="variables_get" id="g12"><field name="VAR" id="vretro">retroceso_maximo</field></block></value>
                          </block></value>
                          <value name="B"><block type="logic_compare" id="cRacha"><field name="OP">LT</field>
                            <value name="A"><block type="variables_get" id="g13"><field name="VAR" id="vracha">perdidas_seguidas</field></block></value>
                            <value name="B"><block type="variables_get" id="g14"><field name="VAR" id="vmax">max_perdidas_seguidas</field></block></value>
                          </block></value>
                        </block>
                      </value>
                    </block>
                  </value>
                </block>
              </value>
              <statement name="DO0"><block type="trade_again" id="ta"></block></statement>
            </block>

            </next>
          </block>

          </next>
        </block>

        </next>
      </block>
    </statement>
  </block>
</xml>
